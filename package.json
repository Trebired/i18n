{
  "name": "@trebired/i18n",
  "version": "0.1.0",
  "description": "Generic colocated TypeScript i18n primitives and checker for Trebired packages and applications.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "config": {
    "organization": {
      "name": "trebired"
    }
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "trebired-i18n": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./checker": {
      "import": "./dist/checker/index.js",
      "types": "./dist/checker/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/prepare-dist.mjs",
    "demo": "bun run examples/dummy.ts",
    "prepublishOnly": "bun run typecheck && bun run build && bun run verify:pack && bun run verify:i18n",
    "typecheck": "tsc --noEmit",
    "verify:i18n": "node ./scripts/verify/i18n.mjs",
    "verify:pack": "node ./scripts/verify/pack.mjs"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^4.7.3",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.1",
    "typescript": "^6.0.2"
  },
  "keywords": [
    "i18n",
    "translations",
    "localization",
    "typescript",
    "node",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/i18n"
  },
  "homepage": "https://github.com/Trebired/i18n#readme",
  "bugs": {
    "url": "https://github.com/Trebired/i18n/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
